# CommuteSure SG needs no API keys, tokens or other secrets. Never put credentials in this file.
# These are non-secret local settings; copy this file to .env in this directory.
# The web client needs no environment variables: Vite proxies /v1 and /health to the API on port 8000.
COMMUTESURE_DEMO_MODE=true
COMMUTESURE_DATABASE_PATH=commutesure.db
COMMUTESURE_SIMULATION_SAMPLES=5000
COMMUTESURE_SIMULATION_SEED=42
COMMUTESURE_VALUE_OF_TIME_PER_HOUR=12
COMMUTESURE_RATE_LIMIT_PER_MINUTE=120
# Optional JSON list, for example ["http://127.0.0.1:5173"]
# COMMUTESURE_ALLOWED_ORIGINS=
